<UserControl x:Class="KursClient.Views.ClientView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:KursClient.Views"
             xmlns:vm="clr-namespace:KursClient.ViewModels"
             xmlns:Menu="clr-namespace:KursClient.Utils"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="900"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             Style="{StaticResource Page_Style}">
    <UserControl.DataContext>
        <vm:ClientViewModel/>
    </UserControl.DataContext>
    <Grid>
        <Border CornerRadius="0,20,20,0" Margin="0,5,5,0">
            <Grid Margin="15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="9*"/>
                    <RowDefinition Height="1*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource ToolBarButtonBaseStyle}"
                        Command="{Binding AddCommand}" Width="30"
                        Height="30" HorizontalAlignment="Right">
                        <Image Source="/Assets/add.png"/>
                    </Button>
                    <Button Style="{StaticResource ToolBarButtonBaseStyle}"
                    Width="30"
                    Height="30" HorizontalAlignment="Right">
                        <Image Source="/Assets/Del.png"/>
                    </Button>
                </StackPanel>
                <DataGrid ItemsSource="{Binding ClientList}"
                      AutoGenerateColumns="False"
                      Grid.Row="1" IsReadOnly="True"
                      SelectedItem="{Binding Selected}" FontSize="14">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="MouseDoubleClick">
                            <i:InvokeCommandAction
                            Command="{Binding EditCommand}"
                            CommandParameter="{Binding Selected}"/>
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Изменить" 
                                  Command="{Binding EditCommand}"
                                  CommandParameter="{Binding Selected}"/>
                            <MenuItem Header="Удалить" 
                                  Command="{Binding DeleteCommand}"
                                  CommandParameter="{Binding Selected}"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Отчество" Width="Auto" Binding="{Binding SurName }"/>
                        <DataGridTextColumn Header="Имя" Width="Auto" Binding="{Binding FirstName}"/>
                        <DataGridTextColumn Header="Фамилия" Width="Auto" Binding="{Binding LastName}"/>
                        <DataGridTextColumn Header="ТипДокумента" Width="Auto" Binding="{Binding TypeOfDocument}"/>
                        <DataGridTextColumn Header="СерияИНомерПаспорта" Width="Auto" Binding="{Binding SerialAndNumberOfDocument}"/>
                        <DataGridTextColumn Header="ДеньРождения" Width="Auto" Binding="{Binding BirthDay}"/>
                        <DataGridTextColumn Header="Пол" Width="Auto" Binding="{Binding Sex}"/>
                        <DataGridTextColumn Header="Адрес" Width="Auto" Binding="{Binding HomeAddress}"/>
                        <DataGridTextColumn Header="НомерРегистрацииКлиента" Width="Auto" Binding="{Binding NumberOfClientRegistration}"/>
                        <DataGridTextColumn Header="НомерКомнатыКлиента" Width="Auto" Binding="{Binding NumberOfRoom}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
