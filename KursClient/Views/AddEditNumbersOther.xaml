<Window x:Class="KursClient.Views.AddEditNumbersOther"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KursClient.Views"
        mc:Ignorable="d"
        Title="AddEditNumbersOther" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0 5" Grid.Row="0">
            <Label Content="Введите Номер Комнаты" Margin="20 0" Foreground="White"/>
            <TextBox x:Name="NumberOfRoom" Text="{Binding NumberOfRoom}" Margin="20 0"/>
        </StackPanel>
        <StackPanel Margin="0 5" Grid.Row="1">
            <Label Content="Введите Тип Номера" Margin="20 0" Foreground="White"/>
            <TextBox x:Name="TypeOfNumber" Text="{Binding TypeOfNumber}" Grid.Row="1" Margin="20 15"/>
        </StackPanel>
        <StackPanel Margin="0 5" Grid.Row="2">
            <Label Content="Введите Количество Мест" Margin="20 0" Foreground="White"/>
            <TextBox x:Name="CountOfMest" Text="{Binding CountOfMest}" Grid.Row="2" Margin="20 15"/>
        </StackPanel>
        <StackPanel Margin="0 5" Grid.Row="4">
            <Label Content="Введите номер Этажа" Margin="20 0" Foreground="White"/>
            <TextBox x:Name="Floor" Text="{Binding Floor}" Grid.Row="4" Margin="20 15"/>
        </StackPanel>
        <StackPanel Margin="0 5" Grid.Row="5">
            <Label Content="Введите номер телефона" Margin="20 0" Foreground="White"/>
            <TextBox x:Name="Phone" Text="{Binding Phone}" Grid.Row="4" Margin="20 15"/>
        </StackPanel>
        <StackPanel Margin="0 5" Grid.Row="6">
            <Label Content="Введите Стоимость В день" Margin="20 0" Foreground="White"/>
            <DatePicker x:Name="CostPerDay" SelectedDate="{Binding CostPerDay}" Grid.Row="4" Margin="20 15"/>
        </StackPanel>
        <StackPanel Margin="0 5" Grid.Row="7">
            <Label Content="Введите Количество свободных мест" Margin="20 0" Foreground="White"/>
            <TextBox x:Name="CountOfFreePlaces" Text="{Binding CountOfFreePlaces}" Grid.Row="4" Margin="20 15"/>
        </StackPanel>
        <StackPanel Margin="0 5" Grid.Row="8">
            <Label Content="Введите Клиента" Margin="20 0" Foreground="White"/>
            <ComboBox ItemsSource="{Binding ClientList}" Grid.Row="8" DisplayMemberPath="FirstName" SelectedValuePath="IdClient"
                      x:Name="ClientList" SelectedValue="{Binding IdClient}"/>
        </StackPanel>
        <Grid Grid.Row="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Button Content="OK" Grid.Column="0" Margin="20 10" Height="50" Click="Button_Click"
    Style="{StaticResource DialogStyle}"/>
            <Button Content="Cancel" Grid.Column="1" Margin="20 10" Height="50" Click="Button_Click_1"
    Style="{StaticResource DialogStyle}"/>
        </Grid>
    </Grid>
</Window>
